# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# For Docker: Use 'db' as hostname (Docker service name)
# For Local: Use 'localhost' as hostname
POSTGRES_URI=postgresql://postgres:admin@db:5432/todo_app
DATABASE_URL=postgresql://postgres:admin@db:5432/todo_app

# PostgreSQL credentials (used by docker-compose to create the database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=todo_app

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port on which the Express server will run
PORT=5000

# Environment mode: development, production, test
NODE_ENV=development

# =============================================================================
# JWT CONFIGURATION
# =============================================================================

# Paths to RSA key files for JWT signing and verification
# Generate keys using: npm run generate-keys (see KEYS_SETUP.md)
JWT_PRIVATE_KEY_PATH="./keys/private.key"
JWT_PUBLIC_KEY_PATH="./keys/public.key"

# JWT token expiration times (in seconds)
# Access token: 900 seconds = 15 minutes
# Refresh token: 604800 seconds = 7 days
JWT_ACCESS_TOKEN_EXPIRE=900
JWT_REFRESH_TOKEN_EXPIRE=604800

# =============================================================================
# CORS & SECURITY
# =============================================================================

# Allowed origin for CORS (frontend URL)
# For Docker with separate frontend: http://localhost:3000
# For production: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# Cookie SameSite attribute: strict, lax, none
# Use 'lax' for development, 'strict' for production
COOKIE_SAMESITE=lax

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 
# FOR DOCKER:
# 1. Copy this file to .env
# 2. Keep DATABASE_URL and POSTGRES_URI with 'db' as hostname
# 3. Run: docker-compose up --build
#
# FOR LOCAL/MANUAL RUN:
# 1. Copy this file to .env
# 2. Change 'db' to 'localhost' in DATABASE_URL and POSTGRES_URI:
#    DATABASE_URL=postgresql://postgres:admin@localhost:5432/todo_app
#    POSTGRES_URI=postgresql://postgres:admin@localhost:5432/todo_app
# 3. Ensure PostgreSQL is running locally on port 5432
# 4. Generate JWT keys: npm run generate-keys
# 5. Run migrations: npx prisma migrate deploy
# 6. Start server: npm start
#
# =============================================================================